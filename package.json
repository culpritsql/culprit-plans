{
  "name": "@culpritsql/plans",
  "version": "0.6.5",
  "description": "Portable WebAssembly execution plan parser, comparator, deadlock & Extended Events (.xel) parser, and exporter for SQL Server, PostgreSQL, MySQL, MariaDB, YugabyteDB, and SQLite.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "pkg"
  ],
  "exports": {
    ".": {
      "types": "./pkg/index.d.ts",
      "import": "./pkg/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/culpritsql/culprit-plans.git"
  },
  "homepage": "https://culpritsql.com",
  "bugs": {
    "url": "https://github.com/culpritsql/culprit-plans/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "sql",
    "execution-plan",
    "query-plan",
    "explain",
    "showplan",
    "sqlplan",
    "deadlock",
    "xel",
    "extended-events",
    "wasm",
    "webassembly",
    "postgres",
    "postgresql",
    "mssql",
    "sql-server",
    "mysql",
    "mariadb",
    "yugabytedb",
    "sqlite"
  ]
}
